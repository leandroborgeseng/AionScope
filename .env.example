PBI_BASE_URL=https://sjh.globalthings.net
PBI_CACHE_SECONDS=900

PBI_TOKEN_CRONOGRAMA=
PBI_TOKEN_TIPO_MANUTENCAO=
PBI_TOKEN_OS_ANALITICO=
PBI_TOKEN_EQUIPAMENTOS=
PBI_TOKEN_TMEF=
PBI_TOKEN_TPM=
PBI_TOKEN_DISP_EQUIPAMENTO=
PBI_TOKEN_DISP_EQUIPAMENTO_MES=
PBI_TOKEN_MONITOR_REACAO=
PBI_TOKEN_MONITOR_ATENDIMENTO=
PBI_TOKEN_ANEXOS_EQUIPAMENTO=
PBI_TOKEN_ANEXOS_OS=
PBI_TOKEN_OS_ANALITICO_RESUMIDO=
PBI_TOKEN_OFICINA=
PBI_TOKEN_CONTRATOS=

# IDs numéricos da empresa no GlobalThings (obrigatório em disponibilidade mês a mês)
PBI_DEFAULT_EMPRESA_IDS=2

# Horário útil da Engenharia Clínica (America/Sao_Paulo)
EC_HORA_INICIO=7
EC_HORA_FIM=17
# Lista opcional YYYY-MM-DD separada por vírgula (além dos feriados em /sala/registros)
EC_FERIADOS=

# Sala TV (quiosque)
SALA_SEGUNDOS=30
# Sequência opcional: agora,fluxo,compras,agora,envelhecimento,programadas,agora,ciclo-de-vida,indicadores,processos
SALA_SEQUENCIA=

# Palavras-chave de TipoAnexo/nome de arquivo considerados obrigatórios
NEXT_PUBLIC_ANEXOS_OBRIGATORIOS=laudo,calibra,certificado,seguranca eletrica,segurança elétrica,tse

# SQLite (parque + contratos + registros manuais da Sala). Coolify/Railway: volume em /data
DATABASE_PATH=/data/aionscope.sqlite
