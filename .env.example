PBI_BASE_URL=https://sjh.globalthings.net
PBI_CACHE_SECONDS=900
# Parque muda pouco — cache longo em memória + disco (/data/pbi-cache). Padrão 12h.
PBI_CACHE_EQUIPAMENTOS_SECONDS=43200
# Opcional: pasta do cache em disco (default = mesmo dir do SQLite + /pbi-cache)
# PBI_DISK_CACHE_DIR=/data/pbi-cache

PBI_TOKEN_CRONOGRAMA=
PBI_TOKEN_TIPO_MANUTENCAO=
PBI_TOKEN_OS_ANALITICO=
PBI_TOKEN_EQUIPAMENTOS=
PBI_TOKEN_TMEF=
PBI_TOKEN_TPM=
PBI_TOKEN_DISP_EQUIPAMENTO=
PBI_TOKEN_DISP_EQUIPAMENTO_MES=
PBI_TOKEN_MONITOR_REACAO=
PBI_TOKEN_MONITOR_ATENDIMENTO=
PBI_TOKEN_ANEXOS_EQUIPAMENTO=
PBI_TOKEN_ANEXOS_OS=
PBI_TOKEN_OS_ANALITICO_RESUMIDO=
PBI_TOKEN_OFICINA=
PBI_TOKEN_CONTRATOS=

# IDs numéricos da empresa no GlobalThings (obrigatório em disponibilidade mês a mês)
PBI_DEFAULT_EMPRESA_IDS=2

# Horário útil da Engenharia Clínica (America/Sao_Paulo)
EC_HORA_INICIO=7
EC_HORA_FIM=17
# Lista opcional YYYY-MM-DD separada por vírgula (além dos feriados em /sala/registros)
EC_FERIADOS=

# Sala TV (quiosque)
SALA_SEGUNDOS=30
# Sequência opcional: agora,fluxo,compras,agora,envelhecimento,programadas,agora,ciclo-de-vida,indicadores,treinamentos,processos
SALA_SEQUENCIA=

# Microsoft 365 — e-mails de compra (só leitura). Ver docs/sala/m365-setup.md
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_CAIXAS=leandro.borges@aion.eng.br,oficina@aion.eng.br
COMPRAS_DESTINOS=compras@hsj.com.br,manutencao@hsj.com.br
COMPRAS_PRAZO_SC_DIAS_UTEIS=2
COMPRAS_PRAZO_ENTREGA_DIAS=15
COMPRAS_SYNC_MIN_SECONDS=300

# URL pública do app (fallback do QR / ficha vida AionScope). Ex.: https://aionscope.up.railway.app
NEXT_PUBLIC_APP_URL=

# QR das etiquetas → Effort Mobile (API de equipamentos NÃO devolve URL).
# Padrão embutido: {base}/Mobile/MEquipamentoPropriedade.aspx?eqp={Id}
# Ex. HSJ-90001 Id=59 → …/MEquipamentoPropriedade.aspx?eqp=59
# Placeholders: {Id} {Tag} {CodigoCliente} {base}
# Sem Id → fallback /equipamentos/{tag} (ficha vida AionScope).
# NEXT_PUBLIC_EFFORT_EQUIPAMENTO_URL_TEMPLATE={base}/Mobile/MEquipamentoPropriedade.aspx?eqp={Id}
# NEXT_PUBLIC_ETIQUETA_QR_BASE=https://sjh.globalthings.net
NEXT_PUBLIC_EFFORT_EQUIPAMENTO_URL_TEMPLATE=
NEXT_PUBLIC_ETIQUETA_QR_BASE=

# Branding impresso na etiqueta (Niimbot B1 · /etiquetas)
# Marca: public/aion-mark.png  |  site: aion.eng.br  |  tel: (16) 3030-0445
# BRAND vazio = coluna preta AION (sem “HSJ · Eng. Clínica”)
NEXT_PUBLIC_ETIQUETA_BRAND=
NEXT_PUBLIC_ETIQUETA_SITE=aion.eng.br
NEXT_PUBLIC_ETIQUETA_TELEFONE=(16) 3030-0445
NEXT_PUBLIC_ETIQUETA_LOGO=/aion-mark.png

# Palavras-chave de TipoAnexo/nome de arquivo considerados obrigatórios
NEXT_PUBLIC_ANEXOS_OBRIGATORIOS=laudo,calibra,certificado,seguranca eletrica,segurança elétrica,tse

# SQLite (parque + contratos + registros manuais da Sala). Coolify/Railway: volume em /data
DATABASE_PATH=/data/aionscope.sqlite

# Origens exatas (esquema + host + porta) das mutações admin do cadastro do bot.
# Várias origens separadas por vírgula. Sem esta lista, POST/PATCH de
# /api/cadastros/bot-usuarios (inclusive revelar telefone) respondem 403.
# GET não usa esta variável. Não há host padrão no código.
# AIONSCOPE_ORIGENS_PERMITIDAS=https://painel.exemplo.test
AIONSCOPE_ORIGENS_PERMITIDAS=

# Papéis do bot, separados por vírgula. Vazio = os cinco rótulos padrão.
# AIONSCOPE_BOT_PAPEIS=
# Dias de auditoria visíveis na tela do bot (padrão 90). O banco guarda 12 meses.
# AIONSCOPE_BOT_AUDITORIA_DIAS_VISIVEIS=90

# Origem pública do link único do grupo (esquema + host, sem caminho e sem barra final).
# Sem esta variável o admin não monta a URL. Não há host padrão no código.
# AIONSCOPE_CONVITE_ORIGEM=https://painel.exemplo.test
AIONSCOPE_CONVITE_ORIGEM=

# IP do limite do formulário público /convite.
# Padrão false: ignora CF-Connecting-IP e usa o IP da conexão
# (último X-Forwarded-For ou x-real-ip).
# Em produção, depois do filtro do Traefik que só aceita as faixas da Cloudflare,
# ligar true para ler CF-Connecting-IP. Sem esse filtro, deixe false.
# TRUST_CF_CONNECTING_IP=true
TRUST_CF_CONNECTING_IP=false

# Limites do formulário (opcionais). Padrão: 60 envios por IP a cada 15 min
# e 5 envios por telefone a cada 60 min.
# AIONSCOPE_CONVITE_LIMITE_IP=60
# AIONSCOPE_CONVITE_LIMITE_IP_MS=900000
# AIONSCOPE_CONVITE_LIMITE_TELEFONE=5
# AIONSCOPE_CONVITE_LIMITE_TELEFONE_MS=3600000

# Anexos de OC (PDF/imagens). Padrão: pasta ordens-compra-anexos ao lado do SQLite.
# Coolify: fica em /data/ordens-compra-anexos se DATABASE_PATH=/data/aionscope.sqlite
# ORDENS_COMPRA_ANEXOS_PATH=/data/ordens-compra-anexos

# Robô E-Mails Compras → API de ordens de compra (não commitar o valor real)
# Bearer nas rotas /api/v1/ordens-compra*. Health (/api/v1/health) não usa chave.
ORDENS_COMPRA_API_KEY=

# Evidências PDF dos treinamentos B. Braun (listas de presença).
# 2026 contém CPF/e-mail — NÃO versionar. Coolify/Railway: copie para /data/treinamentos-evidencias/
# Token opcional (se vazio, PDFs liberados quando existirem no volume). UI: Treinamentos · bombas.
TREINAMENTOS_EVIDENCIAS_TOKEN=
# TREINAMENTOS_EVIDENCIAS_PATH=/data/treinamentos-evidencias
